# Perfil de Spring Boot activo:
#   dev  -> MariaDB en localhost:3306/db_payments, sin BD externa obligatoria
#   prod -> MariaDB vía las variables DB_* de abajo
SPRING_PROFILES_ACTIVE=dev

# --- Servidor ---
SERVER_PORT=8086

# --- Base de datos (la usan las variables del perfil prod) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_payments
DB_USER=svc_payments
DB_PASSWORD=<your_password_here>
